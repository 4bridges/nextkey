# NextKey — environment for the scripts that write to the chain.
#
# Copy to .env and fill in. Every script runs without this file in print-only
# mode: it shows the exact call it would make instead of making it, which is
# the right way to inspect a step before arming it.
#
# ─────────────────────────────────────────────────────────────────────────────
# SAFETY, and this is not boilerplate.
#
#   Never put a seed phrase or recovery phrase here. Not in this file, not in a
#   terminal, not in a chat. A single account's private key is all any script
#   needs, and it is the only thing that belongs here.
#
#   Use a wallet that holds testnet assets only. A private key in a plain file
#   is acceptable for Sepolia and mock tokens and for nothing else. If this
#   wallet is ever pointed at mainnet, create a new one instead.
#
#   .env is gitignored. Confirm it before every commit:
#       git check-ignore -v .env
# ─────────────────────────────────────────────────────────────────────────────

# The owner key. 0x-prefixed, 66 characters including the prefix.
# In MetaMask: account menu → Account details → Show private key.
REGISTRAR_PRIVATE_KEY=

# Optional. The default endpoint permits wider getLogs ranges than most public
# Sepolia RPCs, which matters when scanning factory events.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional. Defaults to NextKey's deployed registry. Set this to your own after
# running scripts/deploy-registry.mjs deploy.
NEXTKEY_REGISTRY=

# Optional. The address subnames are registered to. Defaults to the owner of
# nextkey.eth on the hackathon deployment.
REGISTRAR_OWNER=
