# NextKey — cache rules for the static host.
#
# Written after a judge on a phone hit "Cannot set properties of null" in the
# MetaMask in-app browser: demo.html was cached from an earlier deploy while
# demo.js beside it was current, and the two disagreed about which elements the
# page has. Clearing the cache is not a real answer — MetaMask's iOS browser has
# a long-standing bug where it does not reliably clear, and a visitor should not
# have to know that anyway.
#
# `no-cache` is not `no-store`. It permits the browser to keep the file and
# requires it to revalidate before use, so an unchanged bundle comes back as a
# 304 with no body. The 650 kB of demo.js is therefore downloaded once, not once
# per visit — while a deploy still takes effect immediately.
<IfModule mod_headers.c>

  # Markup and code: always ask. These are the two that must agree with each
  # other, and they are the two that change.
  <FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Decoration: logos, icons, the manifest. These change when we rename them,
  # which is to say almost never, and a stale one costs nobody anything.
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webmanifest|woff|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

</IfModule>

# ── The network is a path prefix, not a copy of the site ───────────────────
#
#   /demo/<tab>   the hackathon deployment on Sepolia
#   /<tab>        mainnet, once it exists
#
# One set of files serves both. That is the whole point: the tabs are the same
# tabs, the markup is the same markup, and the only thing that differs is which
# chain the page reads — which it takes from its own address rather than from a
# build flag, a copy of the directory, or a second domain.
#
# It costs two conventions inside the pages, and they are worth naming here
# because a change to either breaks this file silently:
#
#   · assets and bundles are root-absolute — /i18n.js, /brand/… — so they are
#     the same URL at both depths and the browser caches them once;
#   · links between tabs are relative and extension-less — ./explorer — so from
#     /demo/id they resolve to /demo/explorer and from /id to /explorer. The
#     prefix carries itself. No page has to know which network it is on.
#
# Home, the imprint and the privacy notice are absolute, because they are the
# same page on every chain.
#
# The extension-less addresses are older than the prefix and the reasoning
# still holds: /explorer.html and /explorer are two spellings of one page, and
# search engines should be offered one.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /explorer.html → /explorer, once. THE_REQUEST is the original request line,
  # so the internal rewrites below cannot re-enter this and loop.
  RewriteCond %{THE_REQUEST} "\s/+([^\s?]+)\.html[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /index and /index.html are the front door; it is spelled /.
  RewriteRule ^index/?$ / [R=301,L]

  # The testnet's own front door.
  RewriteRule ^demo/?$ /demo/id [R=302,L]

  # Two tabs, one file. /passphrase and /message are the same five steps with
  # different contents — the page reads which one it is off its own path — so
  # there is one implementation and two addresses rather than two copies of
  # forty kilobytes of markup and its translations.
  #
  # It has to be spelled out here because the rule below maps a tab to the file
  # of the same name, and there is no message.html to map to. Getting this wrong
  # is a 404 on a tab in the navigation, which is what it was before this line
  # existed.
  RewriteRule ^demo/(passphrase|message)/?$ /demo.html [L]

  # Every other /demo/<tab> → <tab>.html, internally. The condition is what
  # keeps this honest: an address that names no page falls through to a 404
  # instead of being answered by whatever file the pattern happened to spell.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^demo/([A-Za-z0-9_-]+)/?$ /$1.html [L]

  # Mainnet is not live yet. Until it is, a bare tab address leads to the
  # testnet — by redirect and not by rewrite, so the address bar always says
  # which chain the visitor is looking at. Deleting these five lines is what
  # launching mainnet will mean.
  RewriteRule ^(id|passphrase|message|explorer|blog|donate|poc)/?$ /demo/$1 [R=302,L]

  # Everything else without an extension: /imprint → imprint.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ETags let the revalidation above answer 304 instead of resending the file.
FileETag MTime Size

# Nothing here is a directory listing. src/ and test/ should not be on the
# server at all, but a deploy that forgets one should not publish an index of it.
Options -Indexes
