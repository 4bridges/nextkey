# NextKey — cache rules for the static host.
#
# Written after a judge on a phone hit "Cannot set properties of null" in the
# MetaMask in-app browser: demo.html was cached from an earlier deploy while
# demo.js beside it was current, and the two disagreed about which elements the
# page has. Clearing the cache is not a real answer — MetaMask's iOS browser has
# a long-standing bug where it does not reliably clear, and a visitor should not
# have to know that anyway.
#
# `no-cache` is not `no-store`. It permits the browser to keep the file and
# requires it to revalidate before use, so an unchanged bundle comes back as a
# 304 with no body. The 650 kB of demo.js is therefore downloaded once, not once
# per visit — while a deploy still takes effect immediately.
<IfModule mod_headers.c>

  # Markup and code: always ask. These are the two that must agree with each
  # other, and they are the two that change.
  <FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Decoration: logos, icons, the manifest. These change when we rename them,
  # which is to say almost never, and a stale one costs nobody anything.
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webmanifest|woff|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

</IfModule>

# ── Addresses without the extension ────────────────────────────────────────
# /explorer rather than /explorer.html. The pages sit in the document root, so
# every relative link inside them (./demo.js, ./i18n.js, ./brand/…) still
# resolves against the root and keeps working — which is why this can be a
# rewrite and does not need any change to the markup.
#
# The rule only fires when the requested path is not a real file or directory,
# so an existing asset is never rewritten, and .html is still served directly
# for anyone who types it or follows an older link.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /explorer.html → /explorer, once, so one address is canonical and search
  # engines are not offered two spellings of the same page.
  RewriteCond %{THE_REQUEST} "\s/+([^\s?]+)\.html[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /explorer → explorer.html, internally.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ETags let the revalidation above answer 304 instead of resending the file.
FileETag MTime Size

# Nothing here is a directory listing. src/ and test/ should not be on the
# server at all, but a deploy that forgets one should not publish an index of it.
Options -Indexes
